{
  "name": "aethersync",
  "version": "1.0.0",
  "private": true,
  "description": "AetherSync - End-to-End Encrypted Communications & Social Nexus",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npx concurrently \"npm run dev --prefix backend\" \"npm run start --prefix frontend\"",
    "dev": "npx concurrently \"npm run dev --prefix backend\" \"npm run start --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "vercel-build": "npm run build --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run start --prefix frontend",
    "test": "npm test --prefix backend && npm run typecheck --prefix frontend"
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "workbox-webpack-plugin": "^7.1.0"
  }
}
